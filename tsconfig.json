// https://nitro.unjs.io/guide/typescript
{
  "extends": [],
  "compilerOptions": {
      "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "baseUrl": ".",
    "paths": {
      "~/*": ["server/*"],
      "#nitro": [".nitro/types/index.d.ts"]
    },
    "lib": ["esnext", "dom"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "server/**/*.ts",
    "nitro.config.ts",
    "types/**/*.d.ts"
  ]
}
